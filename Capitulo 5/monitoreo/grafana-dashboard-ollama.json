{
  "title": "Ollama - Servidor educativo local (Capítulo 5)",
  "uid": "cap5-ollama-local",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Servidor Ollama activo",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "ollama_up", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Caído" }, "1": { "text": "Activo" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Modelos cargados actualmente",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "ollama_loaded_models_total", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Duración de la última consulta a la API de Ollama (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "ollama_scrape_duration_seconds", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Tamaño de cada modelo cargado (bytes)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "ollama_model_size_bytes", "legendFormat": "{{model}}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Uso de CPU del servidor (node_exporter)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "% CPU en uso",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Memoria RAM disponible (node_exporter)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "RAM disponible",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}
